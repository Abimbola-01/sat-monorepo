# Qorvi backend environment variables
# Copy this file to .env and fill in the values.

# Node env
NODE_ENV=development

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=qorvi
DB_USER=qorvi
DB_PASSWORD=change-me

# Clerk (sign-in / sign-up)
CLERK_SECRET_KEY=change-me

# Optional: upload temp dir (defaults to ./uploads relative to cwd)
# UPLOAD_DIR=./uploads
